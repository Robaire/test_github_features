#!/bin/sh
# Reject the commit when Spotless finds formatting violations.
set -u

cd "$(git rev-parse --show-toplevel)"

echo "pre-commit: checking formatting with Spotless"
if ! ./gradlew spotlessCheck --console=plain; then
  echo >&2
  echo "pre-commit: formatting check failed." >&2
  echo "Fix the files with: ./gradlew spotlessApply" >&2
  echo "Then stage the formatted files and commit again." >&2
  exit 1
fi
